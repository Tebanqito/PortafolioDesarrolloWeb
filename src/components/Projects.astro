---
const projects = [
  {
    name: 'API de pagos distribuida',
    status: 'en producción',
    description:
      'Servicio de procesamiento de pagos con colas de mensajes para garantizar consistencia entre reintentos y evitar cobros duplicados.',
    stack: ['Node.js', 'PostgreSQL', 'RabbitMQ', 'Docker'],
    repo: 'https://github.com/tuusuario/payments-api',
    demo: '',
  },
  {
    name: 'Panel de monitoreo interno',
    status: 'en producción',
    description:
      'Dashboard para visualizar métricas de infraestructura en tiempo real, con alertas configurables y exportación de reportes.',
    stack: ['Python', 'FastAPI', 'React', 'Redis'],
    repo: 'https://github.com/tuusuario/monitoring-panel',
    demo: 'https://monitoring-demo.example.com',
  },
  {
    name: 'Migrador de esquemas SQL',
    status: 'mantenimiento',
    description:
      'Herramienta de línea de comandos para versionar y migrar esquemas de base de datos entre entornos sin downtime.',
    stack: ['Go', 'PostgreSQL', 'CLI'],
    repo: 'https://github.com/tuusuario/schema-migrator',
    demo: '',
  },
  {
    name: 'Sistema de autenticación reutilizable',
    status: 'archivado',
    description:
      'Librería de autenticación con soporte para OAuth2 y JWT, pensada para integrarse en varios microservicios del mismo equipo.',
    stack: ['Node.js', 'TypeScript', 'JWT'],
    repo: 'https://github.com/tuusuario/auth-lib',
    demo: '',
  },
];

const statusColor: Record<string, string> = {
  'en producción': 'text-ok',
  mantenimiento: 'text-amber',
  archivado: 'text-muted',
};
---

<section id="proyectos" class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-semibold text-paper sm:text-3xl">Proyectos</h2>
    <p class="mt-3 max-w-prose text-sm text-muted">
      Una selección de trabajos recientes, del lado del servidor hacia afuera.
    </p>

    <div class="mt-10 divide-y divide-line border-y border-line">
      {projects.map((project) => (
        <article class="grid gap-4 py-7 sm:grid-cols-[1fr_1.6fr] sm:gap-8">
          <div>
            <h3 class="text-lg font-medium text-paper">{project.name}</h3>
            <p class={`mt-1 font-mono text-xs ${statusColor[project.status]}`}>
              {project.status}
            </p>
          </div>

          <div>
            <p class="text-sm leading-relaxed text-muted">{project.description}</p>

            <ul class="mt-4 flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <li class="rounded-sm border border-line px-2 py-0.5 text-xs text-muted">
                  {tech}
                </li>
              ))}
            </ul>

            <div class="mt-4 flex gap-5">
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-paper underline decoration-line underline-offset-4 hover:decoration-amber"
              >
                Repositorio
              </a>
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-paper underline decoration-line underline-offset-4 hover:decoration-amber"
                >
                  Demo
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
